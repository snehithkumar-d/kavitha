{{!< default}}

{{#post}}

<article class="page page-about {{post_class}}" itemscope itemtype="http://schema.org/AboutPage">

    {{#if @page.show_title_and_feature_image}}
        <header class="page-about-header">
            <div class="container">
                <div class="page-breadcrumb">~ /about</div>
                <h1 class="page-about-title" itemprop="name">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="page-about-deck">{{custom_excerpt}}</p>
                {{/if}}
            </div>
        </header>
    {{/if}}

    <div class="container container-narrow">
        {{#if @page.show_title_and_feature_image}}
            {{#if feature_image}}
                <figure class="page-about-portrait">
                    <img src="{{img_url feature_image size="s"}}"
                         srcset="{{img_url feature_image size="xs"}} 160w,
                                 {{img_url feature_image size="s"}} 480w"
                         sizes="(min-width: 720px) 280px, 60vw"
                         alt="{{feature_image_alt}}"
                         loading="eager"
                         decoding="async"
                         width="280" height="280" />
                </figure>
            {{/if}}
        {{/if}}

        <div class="post-body page-body" itemprop="text">
            {{content}}
        </div>
    </div>

</article>

{{!-- ProfilePage structured data. mainEntity points at the owner's Person node
     (partials/person-jsonld.hbs), which uses the same @id: {{@site.url}}/#<first author's slug>.
     Google uses ProfilePage to understand that this page is about one person. --}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": "{{@site.url}}/about/#profilepage",
    "url": "{{@site.url}}/about/",
    "name": "{{meta_title}}",
    "dateCreated": "{{date published_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "dateModified": "{{date updated_at format="YYYY-MM-DDTHH:mm:ssZ"}}",
    "mainEntity": { "@id": "{{@site.url}}/#{{primary_author.slug}}" }
}
</script>

{{/post}}
