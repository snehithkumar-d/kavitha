{{!--
    One entry in the /experience/ timeline rail.

    Convention (authored in Ghost admin):
      - title           = "Role @ Company"                  (e.g. "Senior Engineer @ Stripe")
      - custom_excerpt  = "Start – End · Location · Type"   (e.g. "2022 – 2024 · SF · Full-time")
      - canonical_url   = LinkedIn URL for the role/company (optional — renders a LinkedIn icon)
      - published_at    = role end date (or far-future for current roles, so they pin to top)
      - tags            = stack as public tags + "#experience" internal tag

    Title rendering: source.js splits the title on " @ " at runtime and wraps
    "@ Company" in <span class="experience-entry-at"> so it can be muted.
    No-JS fallback shows the full title in --ink (still legible).
--}}
<li class="experience-entry">
    <div class="experience-entry-rail" aria-hidden="true">
        <span class="experience-entry-dot"></span>
    </div>

    <div class="experience-entry-content">
        <h3 class="experience-entry-title">
            <a class="experience-entry-role" href="{{url}}">{{title}}</a>
            {{#if canonical_url}}
                <a class="experience-entry-link" href="{{canonical_url}}" rel="noopener" target="_blank" aria-label="View on LinkedIn">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                        <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/>
                    </svg>
                </a>
            {{/if}}
        </h3>

        {{#if custom_excerpt}}
            <p class="experience-entry-meta">{{custom_excerpt}}</p>
        {{/if}}

        {{#if tags}}
            <p class="experience-entry-stack">
                {{#foreach tags visibility="public"}}
                    <span>{{name}}</span>
                {{/foreach}}
            </p>
        {{/if}}
    </div>
</li>
