{{!-- Person structured data for the site owner. Rendered on every page.

     Why: Ghost's own JSON-LD describes the site publisher as an Organization and
     gives the post author no @id or sameAs. Other sites (for example product
     sites that credit "built by ...") reference the owner by a stable @id. That
     @id only resolves if a Person node with the same @id exists on the canonical
     home page. This partial provides it, and repeats it on every page so the
     owner is described the same way wherever a crawler lands.

     @id is {{@site.url}}/#<first author's slug>. On a single-author site the slug
     is the owner's slug (for example "snehith" gives https://snehithkumar.com/#snehith).
     name is the site title. When the author's display name in Ghost differs from
     the site title (for example a full legal name), it is added as alternateName so
     both spellings resolve to one entity. image comes from the author's profile
     image. No theme setting is used: the theme is already at Ghost's 20-custom-setting
     limit.

     sameAs comes from the GitHub / X / LinkedIn URLs already in theme settings, so
     nothing personal is hardcoded. Handlebars escapes HTML entities but never emits
     raw quotes, so the JSON stays valid. --}}
{{#get "authors" limit="1"}}{{#foreach authors}}<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "{{@site.url}}/#{{slug}}",
    "name": "{{@site.title}}",{{#match name "!=" @site.title}}
    "alternateName": "{{name}}",{{/match}}{{#if profile_image}}
    "image": "{{profile_image}}",{{/if}}
    "url": "{{@site.url}}/"{{#if @custom.github_url}},
    "sameAs": [
        "{{@custom.github_url}}"{{#if @custom.linkedin_url}},
        "{{@custom.linkedin_url}}"{{/if}}{{#if @custom.twitter_url}},
        "{{@custom.twitter_url}}"{{/if}}
    ]{{else if @custom.linkedin_url}},
    "sameAs": [
        "{{@custom.linkedin_url}}"{{#if @custom.twitter_url}},
        "{{@custom.twitter_url}}"{{/if}}
    ]{{else if @custom.twitter_url}},
    "sameAs": [
        "{{@custom.twitter_url}}"
    ]{{/if}}
}
</script>{{/foreach}}{{/get}}
