{{!-- Related posts — pulls 3 posts sharing the current post's primary tag,
     excluding the current post itself AND posts that belong to a different
     collection. A writing post must not pull in #project or #experience
     entries even when they share a public tag (e.g. "AWS"); a project post
     can still pull in other projects so it excludes only #experience.

     The experience collection's custom-experience.hbs does not include this
     partial — role detail pages don't render a "More on" section. --}}

{{#if primary_tag}}
    {{#has tag="hash-project"}}
        {{!-- Current post is a project: allow other projects in related, exclude experience. --}}
        {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}+tag:-hash-experience" limit="3" order="published_at desc" as |related|}}
            {{#if related}}
                <section class="related-posts" aria-labelledby="related-heading">
                    <h3 id="related-heading" class="related-posts-heading">More on {{primary_tag.name}}</h3>
                    <ul class="related-posts-list">
                        {{#foreach related}}
                            <li>
                                <a href="{{url}}">
                                    <span class="related-posts-title">{{title}}</span>
                                    <span class="related-posts-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>{{#if reading_time}} · {{reading_time}}{{/if}}</span>
                                </a>
                            </li>
                        {{/foreach}}
                    </ul>
                </section>
            {{/if}}
        {{/get}}
    {{else}}
        {{!-- Current post is a writing post: exclude both internal-tag collections. --}}
        {{#get "posts" filter="tags:[{{primary_tag.slug}}]+id:-{{id}}+tag:-hash-project+tag:-hash-experience" limit="3" order="published_at desc" as |related|}}
            {{#if related}}
                <section class="related-posts" aria-labelledby="related-heading">
                    <h3 id="related-heading" class="related-posts-heading">More on {{primary_tag.name}}</h3>
                    <ul class="related-posts-list">
                        {{#foreach related}}
                            <li>
                                <a href="{{url}}">
                                    <span class="related-posts-title">{{title}}</span>
                                    <span class="related-posts-meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>{{#if reading_time}} · {{reading_time}}{{/if}}</span>
                                </a>
                            </li>
                        {{/foreach}}
                    </ul>
                </section>
            {{/if}}
        {{/get}}
    {{/has}}
{{/if}}
