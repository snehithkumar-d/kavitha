{{!< default}}

{{!--
    Role detail template — auto-resolves for posts whose primary collection is
    /experience/ (custom-experience template in routes.yaml). Mirrors the layout
    pattern from post-project.hbs but tuned for a single career role:

      ~ /experience          (breadcrumb)
      ← All roles            (back link)
      Role @ Company         (title; "@ Company" muted by source.js)
      meta line + LinkedIn   (custom_excerpt + optional canonical_url icon)
      ----
      [post body — accomplishments, bullets, links]
      ----
      ← Previous role | Next role →
--}}

{{#post}}

<article class="post post-experience {{post_class}}" itemscope itemtype="http://schema.org/CreativeWork">

    <header class="post-experience-header">
        <div class="container container-narrow">
            <div class="page-breadcrumb">~ /experience</div>
            <a class="post-experience-back" href="/experience/">← All roles</a>

            <h1 class="post-experience-title experience-entry-title" itemprop="name">
                <span class="experience-entry-role">{{title}}</span>
                {{#if canonical_url}}
                    <a class="experience-entry-link" href="{{canonical_url}}" rel="noopener" target="_blank" aria-label="View on LinkedIn">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/>
                        </svg>
                    </a>
                {{/if}}
            </h1>

            {{#if custom_excerpt}}
                <p class="post-experience-meta">{{custom_excerpt}}</p>
            {{/if}}

            {{#if tags}}
                <p class="post-experience-stack">
                    {{#foreach tags visibility="public"}}<span>{{name}}</span>{{/foreach}}
                </p>
            {{/if}}
        </div>
    </header>

    <div class="container container-narrow">
        <div class="post-body" itemprop="text">
            {{content}}
        </div>
    </div>

</article>

<div class="container container-narrow">
    <nav class="post-prev-next" aria-label="Adjacent roles">
        {{#prev_post}}
            <a class="post-prev" href="{{url}}">
                <span class="label">← Previous role</span>
                <span class="title">{{title}}</span>
            </a>
        {{/prev_post}}
        {{#next_post}}
            <a class="post-next" href="{{url}}">
                <span class="label">Next role →</span>
                <span class="title">{{title}}</span>
            </a>
        {{/next_post}}
    </nav>
</div>

{{/post}}
